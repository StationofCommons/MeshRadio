#!/usr/bin/env bash
# Receive the voice from the previous station, play it here, and pass it on
# to the next station at a lower volume. Nothing is written to disk.
# Settings come from /etc/meshradio/station.conf.
set -euo pipefail

CONF="${MESHRADIO_CONF:-/etc/meshradio/station.conf}"
# shellcheck disable=SC1090
source "$CONF"
: "${RTP_PORT:=5000}" "${JITTER_MS:=150}" "${HOP_VOLUME:=0.85}"

exec gst-launch-1.0 -e udpsrc port="$RTP_PORT" \
  caps="application/x-rtp,media=audio,clock-rate=48000,encoding-name=L16,channels=1,payload=96" \
  ! rtpjitterbuffer latency="$JITTER_MS" drop-on-latency=false do-lost=true \
  ! rtpL16depay ! audioconvert ! tee name=t \
  t. ! queue ! audioresample ! alsasink device="$AUDIO_OUT" \
  t. ! queue ! volume volume="$HOP_VOLUME" ! audioconvert \
  ! audio/x-raw,format=S16BE,rate=48000,channels=1 ! rtpL16pay \
  ! udpsink host="$NEXT_HOP_IP" port="$RTP_PORT"
